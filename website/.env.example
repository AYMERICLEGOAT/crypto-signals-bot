# Copie ce fichier en ".env" et remplis les valeurs. Ne commit jamais le ".env" réel.

# --- Supabase (même projet que les modules signals/ et bot/) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- GitHub (dépôt du site statique, connecté à Cloudflare Pages) ---
# Token : https://github.com/settings/tokens (scope "repo" suffit, classic ou fine-grained)
GITHUB_TOKEN=ghp_votre_token
GITHUB_REPO=votre-utilisateur/votre-repo-site
GITHUB_BRANCH=main
# Sous-dossier du dépôt si le site n'est pas à la racine (laisser vide si le
# dépôt ne contient QUE le site). Recommandé "public" si le même dépôt contient
# aussi le code source des autres modules — configure alors Cloudflare Pages
# avec "public" comme dossier de sortie (build output directory).
SITE_SUBDIR=public

# --- Site ---
SITE_BASE_URL=https://votre-site.pages.dev
SITE_NAME=Signaux Crypto Gratuits
TELEGRAM_BOT_USERNAME=ProVIPSignals_bot
