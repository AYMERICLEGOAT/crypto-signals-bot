# Copie ce fichier en ".env" et remplis les valeurs.
# Récupérables dans Supabase : Project Settings -> API.

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optionnel : alerte admin directe si les 4 sources de données (Binance/
# CoinGecko/Coinbase/Kraken) échouent 3 cycles de suite (voir alerts.py).
# Sans ces valeurs, l'alerte est simplement journalisée. Même token que le
# bot Telegram/Worker. ADMIN_TELEGRAM_ID a déjà une valeur par défaut dans
# config.py (non sensible).
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_ID=
