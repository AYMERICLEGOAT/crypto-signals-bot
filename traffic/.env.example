# Copie ce fichier en ".env" et remplis les valeurs. Ne commit jamais le ".env" réel.

# --- Supabase (même projet que les modules précédents) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Liens promotionnels ---
TELEGRAM_CHANNEL_URL=https://t.me/votre_canal_public
TELEGRAM_BOT_USERNAME=ProVIPSignals_bot

# --- Twitter/X (developer.twitter.com, tier gratuit) ---
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
# Vérifie la limite RÉELLE affichée dans ton portail développeur avant de la changer.
TWITTER_MAX_PER_DAY=3
TWITTER_MAX_PER_MONTH=100
TWITTER_MIN_DELAY_SECONDS=120
TWITTER_MAX_DELAY_SECONDS=1800

# --- Reddit (praw, compte "script app" unique — https://www.reddit.com/prefs/apps) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=signal-promo-bot/1.0 by VOTRE_NOM_UTILISATEUR
# ⚠️ Vérifie les règles d'auto-promotion de CHAQUE subreddit avant de l'ajouter (voir README).
REDDIT_SUBREDDITS=CryptoCurrency,CryptoMarkets,cryptotrading
REDDIT_MIN_INTERVAL_DAYS=2

# --- Discord (Developer Portal, application + bot) ---
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_COMMAND_PREFIX=!
