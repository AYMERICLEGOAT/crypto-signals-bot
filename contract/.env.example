# Copie ce fichier en ".env" et remplis les valeurs. Ne commit jamais le ".env" réel.

# Clé privée du wallet qui PAIE LE GAS pour déployer le contrat.
# Ce n'est pas forcément le wallet OWNER (hardcodé dans le contrat) :
# n'importe quel wallet avec assez de MATIC/POL peut déployer.
# ⚠️ Ne jamais partager cette clé, ne jamais la committer.
DEPLOYER_PRIVATE_KEY=0xVOTRE_CLE_PRIVEE_DE_DEPLOIEMENT

# RPC Polygon Mainnet (public, gratuit, aucune clé requise).
POLYGON_RPC_URL=https://polygon-rpc.com

# RPC Polygon Amoy (testnet gratuit, recommandé pour tester avant le mainnet).
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Optionnel : clé API Polygonscan gratuite, pour vérifier le contrat après déploiement.
# https://polygonscan.com/myapikey
POLYGONSCAN_API_KEY=
