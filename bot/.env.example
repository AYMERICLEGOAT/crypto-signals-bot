# Copie ce fichier en ".env" et remplis les valeurs. Ne commit jamais le ".env" réel
# (déjà exclu par .gitignore).

# --- Telegram ---
# Obtenu auprès de @BotFather. ⚠️ Secret : quiconque le possède contrôle le bot.
TELEGRAM_BOT_TOKEN=1234567890:VOTRE_TOKEN_BOTFATHER
# Nom d'utilisateur public du bot (sans @), utilisé pour construire les liens de parrainage.
TELEGRAM_BOT_USERNAME=ProVIPSignals_bot

# --- Supabase (même projet que le module signals/) ---
# Utilise la clé service_role (pas la clé anon) : le bot doit pouvoir écrire
# dans users / pending_payments indépendamment des policies RLS publiques.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Polygon / Smart contract ---
POLYGON_RPC_URL=https://polygon-rpc.com
# Adresse affichée après `npm run deploy:polygon` dans contract/.
CONTRACT_ADDRESS=0xADRESSE_DU_CONTRAT_DEPLOYE
# Clé privée du wallet OWNER (0x71367B5f4519700a63c2564b754cF959317E1f61) : signe
# setTrial() et withdraw(). TRÈS SENSIBLE — voir avertissements dans README.md.
ADMIN_PRIVATE_KEY=0xCLE_PRIVEE_DU_WALLET_OWNER

# --- Monero ---
# URL de monero-wallet-rpc : locale (http://127.0.0.1:18082/json_rpc) si le bot
# tourne sur le même PC, ou URL ngrok si le bot tourne à distance.
MONERO_WALLET_RPC_URL=http://127.0.0.1:18082/json_rpc
# Uniquement si monero-wallet-rpc est lancé avec --rpc-login (recommandé).
MONERO_WALLET_RPC_USER=
MONERO_WALLET_RPC_PASSWORD=
MONERO_MIN_CONFIRMATIONS=10

# --- Litecoin ---
# xpub généré une fois via `npm run generate-ltc-wallet` (voir scripts/).
LTC_ACCOUNT_XPUB=
# Clé gratuite sur https://blockchair.com/api/plans (facultative mais recommandée : rate-limit plus élevé)
BLOCKCHAIR_API_KEY=
LTC_MIN_CONFIRMATIONS=1

# --- Cadence des tâches de fond (millisecondes) ---
PAYMENT_CHECK_INTERVAL_MS=120000
SIGNAL_DISPATCH_INTERVAL_MS=300000
EVENT_CATCHUP_INTERVAL_MS=60000
